diff --git a/deploy-treptow-theme.sh b/deploy-treptow-theme.sh
index f1057c0..0000000 100644
--- a/deploy-treptow-theme.sh
+++ b/deploy-treptow-theme.sh
@@ -8,6 +8,7 @@ set -euo pipefail
 
 SEARX_SRC="${SEARX_SRC:-$HOME/opt/searx/searxng-src}"
 CUSTOM_DIR="${CUSTOM_DIR:-$HOME/custom-theme/treptow}"
+SETTINGS="${SETTINGS:-$HOME/etc/searx/settings.yml}"
 
 cd "$SEARX_SRC"
 
@@ -16,18 +17,21 @@ rsync -a --delete "$CUSTOM_DIR/templates/treptow/" "searx/templates/treptow/"
